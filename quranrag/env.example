# Opsional: jika diisi, GET /graph-config wajib header X-Graph-Config-Token yang sama.
# Kosongkan untuk pengembangan lokal (Origin Vite tetap dicek).
GRAPH_CONFIG_TOKEN=

# Origin browser yang boleh memanggil GET /graph-config (pisahkan dengan koma).
# Contoh saat Vite pindah port: http://127.0.0.1:5174,http://localhost:5174
# Kosongkan untuk default 5173.
GRAPH_CONFIG_ORIGINS=

# Set false jika LANGSMITH_API_KEY tidak valid (menghindari 403 berulang di log).
