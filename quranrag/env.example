# Wajib. Gunakan akun Neo4j dengan izin baca untuk aplikasi.
NEO4J_LOKAL_URI=bolt://127.0.0.1:7687
NEO4J_LOKAL_USER=neo4j
NEO4J_LOKAL_PASSWORD=
NEO4J_DATABASE=neo4j
OPENAI_API_KEY=
PINECONE_API_KEY=
INDEX_NAME1=

# Model embedding WAJIB sama dengan model saat membangun indeks Pinecone.
EMBEDDING_MODEL=text-embedding-ada-002
LLM_MODEL=gpt-4o-mini-2024-07-18
# Opsional untuk penyedia API kompatibel OpenAI.
OPENAI_BASE_URL=
# Opsional: lewati lookup host Pinecone jika host indeks telah diketahui.
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=

# Origin WebSocket yang diizinkan; bukan mekanisme autentikasi.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Batas per proses backend. Timeout 1–120 detik.
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=12
RETRIEVAL_TOP_K=5
MAX_VERSES_PER_PATH=25
MAX_CONTEXT_VERSES=60
MAX_CONTEXT_CHARS=30000

# Tracing hanya aktif jika sengaja diaktifkan dengan kredensial valid.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
